# ─── Required ────────────────────────────────────────────────────────────────

# Your Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key — https://resend.com (free tier: 3,000 emails/mo)
RESEND_API_KEY=re_...

# Your girlfriend's email address
RECIPIENT_EMAIL=her@email.com

# The "from" address shown in the email.
# Must be a verified domain in Resend, or use onboarding@resend.dev for testing.
SENDER_EMAIL=Remote Social Work Digest <digest@yourdomain.com>

# ─── Optional (adds more job sources if set) ─────────────────────────────────

# USA Jobs API — free, register at https://developer.usajobs.gov/
# Adds federal/government social work positions (many are remote-eligible)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com

# ZipRecruiter Partner API — free to register at https://www.ziprecruiter.com/jobs-api
ZIPRECRUITER_API_KEY=
